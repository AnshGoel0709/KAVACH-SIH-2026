{
  "name": "@drishti/api",
  "version": "0.1.0",
  "description": "Backend API and Orchestration Service for Drishti",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drishti/audit-logger": "*",
    "@drishti/browser-agent": "*",
    "@drishti/core": "*",
    "@drishti/privacy-guard": "*",
    "@drishti/vision-engine": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
