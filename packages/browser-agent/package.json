{
  "name": "@drishti/browser-agent",
  "version": "0.1.0",
  "description": "Playwright-based browser automation session controller for Drishti",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drishti/core": "*",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
